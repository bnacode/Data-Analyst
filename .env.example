# Google Cloud project used to run (and bill) BigQuery queries
GOOGLE_CLOUD_PROJECT=your-project-id
# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key
# Model per agent, sized to the task. The analyst and report models default to GEMINI_MODEL.
# Coordinator: routes and chats on every message, so a cheap, fast model
GEMINI_MODEL=gemini-3.5-flash-lite
# Data analyst: writes and repairs SQL
GEMINI_ANALYST_MODEL=gemini-3.5-flash
# Report writer: long-form reports with insights and action items
GEMINI_REPORT_MODEL=gemini-3.5-flash
# Optional: secret that keeps "Customer #..." labels stable across runs; random per run if unset
# PSEUDONYM_KEY=
